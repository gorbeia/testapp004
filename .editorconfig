root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.{kt,kts}]
indent_size = 4
max_line_length = 120

# Wildcard imports are standard in Jetpack Compose — disabling this rule
# avoids noise from the large Compose API surface
ktlint_standard_no-wildcard-imports = disabled

[*.xml]
indent_size = 4

[*.{yml,yaml}]
indent_size = 2
